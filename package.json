{
  "name": "@notoonex/dsh-project-board",
  "version": "0.1.0",
  "description": "Project record system for DeepSeek Harness: a node-based progress board, a decision ledger, and a right-sidebar UI.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "DSH Project Board contributors",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "project-management",
    "decision-log",
    "adr",
    "obsidian",
    "skill"
  ],
  "files": [
    "lib",
    "client",
    "server",
    "skill",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "PUBLISHING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node server/server.mjs",
    "test": "node tests/lint.test.mjs && node tests/server.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Notoonex/dsh-project-board.git"
  },
  "homepage": "https://github.com/Notoonex/dsh-project-board#readme",
  "bugs": {
    "url": "https://github.com/Notoonex/dsh-project-board/issues"
  }
}
